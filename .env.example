# Public URL of the deployed site (used for SEO, sitemap, social previews)
NEXT_PUBLIC_SITE_URL=https://icrohan.github.io

# Only if the site is served from a sub-path such as https://icrohan.github.io/portfolio
# BASE_PATH=/portfolio

# Optional: raises the GitHub API rate limit for the repositories section at build time (no scopes needed).
# The GitHub Actions deploy workflow passes its own token automatically.
GITHUB_TOKEN=
